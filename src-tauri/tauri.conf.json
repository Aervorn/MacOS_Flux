{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flux",
  "version": "0.7.0",
  "identifier": "io.github.aervorn.flux",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../web-dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Flux",
        "width": 1400,
        "height": 860,
        "minWidth": 900,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "News",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "hardenedRuntime": false
    }
  }
}
